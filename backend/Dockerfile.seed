# One-shot job: applies the Prisma schema to the SQLite file and seeds it.
# Full (non-slim) image: Prisma's schema engine needs OpenSSL, which slim lacks.
FROM node:22

WORKDIR /app

COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

CMD ["npm", "run", "db:reset"]
