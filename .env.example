# Copy to .env (git-ignored) and fill in. docker compose reads .env automatically.
#
# AI provider for the backend's AI layer. Everything here is optional: with no
# key, the app still runs, and requests that need the model's judgment are
# escalated to a human instead. The policy engine always makes the binding
# decision; the model only advises.
#
# EASIEST: set ONE of these and leave the rest empty. The provider is detected
# from whichever key is set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OR: a single generic key. The provider is inferred from its prefix
# (sk-ant- → Anthropic, sk-or- → OpenRouter, sk- → OpenAI, AIza → Gemini).
# Set AI_PROVIDER explicitly for anything else.
#
# OpenRouter example (e.g. a free model): only a key and the model id are needed.
#   AI_API_KEY=sk-or-v1-...
#   AI_MODEL=<model id copied from the model's OpenRouter page, e.g. google/...:free>
AI_API_KEY=

# Optional: force a provider: anthropic | openai | gemini | openai-compatible
AI_PROVIDER=

# Optional: override the model. Defaults: anthropic → claude-opus-5,
# openai → gpt-4.1, gemini → gemini-2.5-flash. Use any current model that
# supports tool/function calling.
AI_MODEL=

# For AI_PROVIDER=openai-compatible (required there, with AI_MODEL): the API
# base URL. Examples:
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   OpenRouter  https://openrouter.ai/api/v1   (automatic for sk-or- keys)
#   Together    https://api.together.xyz/v1
#   Ollama      http://host.docker.internal:11434/v1   (no key needed)
AI_BASE_URL=
